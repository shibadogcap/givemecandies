[Unit]
Description=candy
After=network.target

[Service]
User=ubuntu
StateDirectory=candy
ExecStart=/opt/candy/candy
Restart=always
RestartSec=1
Environment=CANDY_MAX_AMOUNT=2000000000000
Environment=CANDY_LIMIT_RATE=0
Environment=CANDY_LIMIT_BURST=0
Environment=CANDY_IDEMPOTENCY=1
LimitNOFILE=65535
Nice=-5

[Install]
WantedBy=multi-user.target
